{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "beacon-to-blue behavior spec",
  "type": "object",
  "required": [
    "id",
    "name",
    "observables"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]+$",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tactics_techniques": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timing_model": {
      "type": "object",
      "properties": {
        "interval_s": {
          "type": "number",
          "minimum": 1e-06
        },
        "jitter_s": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        },
        "min_samples": {
          "type": "integer",
          "minimum": 3,
          "default": 3
        }
      },
      "additionalProperties": false,
      "required": [
        "interval_s"
      ]
    },
    "observables": {
      "type": "object",
      "properties": {
        "process_creation": {
          "type": "object",
          "properties": {
            "image_contains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "command_line_contains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "http": {
          "type": "object",
          "properties": {
            "domains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "uri_contains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "false_positive_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_telemetry": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
